{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@urth/three-html-panel/agent": ["../../../src/agent/index.ts"],
      "@urth/three-html-panel/page": ["../../../src/agent/page.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte"]
}
