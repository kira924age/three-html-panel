{
  "name": "three-html-panel",
  "version": "0.1.0",
  "description": "Show existing web pages, scripts included and from any origin, as interactive panels in a three.js scene",
  "keywords": [
    "html",
    "iframe",
    "panel",
    "three",
    "three.js",
    "ui",
    "vr",
    "webxr"
  ],
  "homepage": "https://github.com/kira924age/three-html-panel#readme",
  "bugs": {
    "url": "https://github.com/kira924age/three-html-panel/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kira924age/three-html-panel.git"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "sideEffects": [
    "./lib/agent-script.js"
  ],
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./agent": {
      "types": "./lib/agent.d.ts",
      "default": "./lib/agent.js"
    },
    "./page": {
      "types": "./lib/page.d.ts",
      "default": "./lib/page.js"
    },
    "./agent-script.js": "./lib/agent-script.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "e2e": "playwright test",
    "pack:lib": "vp pack",
    "prepublishOnly": "vp check && vp test run && vp pack"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/three": "0.186.0",
    "jsdom": "30.1.2",
    "publint": "0.3.25",
    "three": "0.186.1",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "three": ">=0.158.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.23.0"
}
